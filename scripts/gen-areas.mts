#!/usr/bin/env tsx
// One-off generator for the Bangladesh area list migration.
//
// Source: https://github.com/nuhil/bangladesh-geocode (public domain dataset of
// Bangladesh divisions, districts and upazilas, exported from bd_geo_code).
// Run: pnpm tsx scripts/gen-areas.mts <dir-with-the-three-json-files> > migration.sql
//
// Kept in the repo so the generated migration can be re-made and checked rather than
// being a wall of data nobody can verify.
import fs from "node:fs";
import path from "node:path";

const dir = process.argv[2];
if (!dir) {
  console.error("Usage: tsx scripts/gen-areas.mts <dir containing divisions.json, districts.json, upazilas.json>");
  process.exit(1);
}

/** The files are phpMyAdmin JSON exports: a header, a database, then the table. */
function rows<T>(file: string): T[] {
  const raw = JSON.parse(fs.readFileSync(path.join(dir, file), "utf8")) as unknown[];
  const table = raw.find(
    (x): x is { type: string; data: T[] } =>
      typeof x === "object" && x !== null && (x as { type?: string }).type === "table",
  );
  if (!table) throw new Error(`No table block in ${file}`);
  return table.data;
}

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;

interface Division { id: string; name: string; bn_name: string }
interface District { id: string; division_id: string; name: string; bn_name: string }
interface Upazila { id: string; district_id: string; name: string; bn_name: string }

const divisions = rows<Division>("divisions.json");
const districts = rows<District>("districts.json");
const upazilas = rows<Upazila>("upazilas.json");

if (divisions.length !== 8) throw new Error(`Expected 8 divisions, got ${divisions.length}`);
if (districts.length !== 64) throw new Error(`Expected 64 districts, got ${districts.length}`);
if (upazilas.length < 480) throw new Error(`Expected ~494 upazilas, got ${upazilas.length}`);

const out: string[] = [];
out.push(`-- Bangladesh divisions, districts and upazilas (thanas).
--
-- Source: https://github.com/nuhil/bangladesh-geocode — a public dataset exported from
-- bd_geo_code. ${divisions.length} divisions, ${districts.length} districts, ${upazilas.length} upazilas, which matches the
-- country's actual administrative structure.
--
-- This is national reference data, NOT shop data: every shop reads the same list, so it
-- has no shop_id and no row-level security beyond "you must be signed in". Customer and
-- supplier addresses point at it (P10, P6).
--
-- Generated by scripts/gen-areas.mts. Do not hand-edit: re-run the generator.

create table public.divisions (
  id    integer primary key,
  name  text not null,
  bn_name text not null
);

create table public.districts (
  id           integer primary key,
  division_id  integer not null references public.divisions(id),
  name         text not null,
  bn_name      text not null
);
create index districts_division_idx on public.districts(division_id);

-- "Upazila" is the official term; shops say "thana". Both are in the UI copy.
create table public.upazilas (
  id           integer primary key,
  district_id  integer not null references public.districts(id),
  name         text not null,
  bn_name      text not null
);
create index upazilas_district_idx on public.upazilas(district_id);

-- Countries, for suppliers who import. Short list on purpose: the ones a Dhaka
-- computer shop actually buys from, plus a catch-all the owner can add to.
create table public.countries (
  code  text primary key check (code ~ '^[A-Z]{2}$'),
  name  text not null
);
`);

out.push("\ninsert into public.divisions (id, name, bn_name) values");
out.push(divisions.map((d) => `  (${d.id}, ${q(d.name)}, ${q(d.bn_name)})`).join(",\n") + ";");

out.push("\ninsert into public.districts (id, division_id, name, bn_name) values");
out.push(districts.map((d) => `  (${d.id}, ${d.division_id}, ${q(d.name)}, ${q(d.bn_name)})`).join(",\n") + ";");

out.push("\ninsert into public.upazilas (id, district_id, name, bn_name) values");
out.push(upazilas.map((u) => `  (${u.id}, ${u.district_id}, ${q(u.name)}, ${q(u.bn_name)})`).join(",\n") + ";");

const COUNTRIES: [string, string][] = [
  ["BD", "Bangladesh"], ["CN", "China"], ["HK", "Hong Kong"], ["TW", "Taiwan"],
  ["SG", "Singapore"], ["MY", "Malaysia"], ["TH", "Thailand"], ["VN", "Vietnam"],
  ["IN", "India"], ["AE", "United Arab Emirates"], ["KR", "South Korea"],
  ["JP", "Japan"], ["US", "United States"], ["DE", "Germany"], ["GB", "United Kingdom"],
];
out.push("\ninsert into public.countries (code, name) values");
out.push(COUNTRIES.map(([c, n]) => `  (${q(c)}, ${q(n)})`).join(",\n") + ";");

out.push(`
-- Signed-in users can read the lists; nobody can change them from the app.
alter table public.divisions enable row level security;
alter table public.districts enable row level security;
alter table public.upazilas  enable row level security;
alter table public.countries enable row level security;

create policy divisions_read on public.divisions for select to authenticated using (true);
create policy districts_read on public.districts for select to authenticated using (true);
create policy upazilas_read  on public.upazilas  for select to authenticated using (true);
create policy countries_read on public.countries for select to authenticated using (true);
`);

process.stdout.write(out.join("\n") + "\n");
