# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Then run `pnpm check` and it will tell you if anything is still missing.
#
# Newer Supabase dashboards lead with "publishable" and "secret" keys. Either pair
# works: use the publishable/anon key below, and the secret/service_role key at the
# bottom. If you only see "Publishable key" and "Secret keys", look for the legacy
# API keys tab for the anon/service_role JWTs — either is fine.

# Looks like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "publishable". Safe in the browser: row-level security still applies.
# Looks like eyJhbGciOi… or sb_publishable_…
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" / "secret". Used ONLY by the setup commands (pnpm shop:init,
# pnpm staff:add), never by the app itself.
#
# This key IGNORES row-level security completely — it can read and change every
# shop's data. So it must never be given a NEXT_PUBLIC_ name, because anything
# NEXT_PUBLIC_ is compiled into the pages every browser downloads. `pnpm staff:add`
# refuses to run if it finds this key under a NEXT_PUBLIC_ name.
# Looks like eyJhbGciOi… or sb_secret_…
SUPABASE_SERVICE_ROLE_KEY=

# Sample data in the browser: no sign-in, nothing saved. Leave this out for a real shop.
#   1 = always use sample data
#   0 = always use the database, and show the real error if the keys are wrong
#       (rather than quietly falling back to sample data)
# NEXT_PUBLIC_DEMO_MODE=1
